# PostgreSQL local (docker compose up -d levanta una en el puerto 5433)
DATABASE_URL="postgresql://cania:cania@localhost:5433/cania?schema=public"
DIRECT_URL="postgresql://cania:cania@localhost:5433/cania?schema=public"
# Supabase (Project Settings → Database → Connection string):
#   DATABASE_URL = "Transaction pooler" (puerto 6543) añadiendo ?pgbouncer=true
#   DIRECT_URL   = "Direct connection" o "Session pooler" (puerto 5432), usada por las migraciones
# Secreto para firmar la cookie de sesión (genera uno con: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
# URL pública de la app (puerto 3025)
APP_URL="http://localhost:3025"
# Notificaciones (opcional). Sin credenciales se registran en consola + NotificationLog
SMTP_URL=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
# Google Calendar del agente de WhatsApp (Kapso). Sin estos datos la sincronización está apagada.
#   GOOGLE_CALENDAR_ID: el id del calendario (termina en @group.calendar.google.com)
#   Cuenta de servicio: deja su JSON en canina/google-service-account.json
#   (o indica otra ruta en GOOGLE_SA_KEY_FILE, o pega el JSON en una línea en GOOGLE_SA_KEY)
GOOGLE_CALENDAR_ID=""
GOOGLE_SA_KEY_FILE=""
GOOGLE_SA_KEY=""
