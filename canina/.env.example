# PostgreSQL (docker compose up -d levanta una en el puerto 5433)
DATABASE_URL="postgresql://cania:cania@localhost:5433/cania?schema=public"
# Secreto para firmar la cookie de sesión (genera uno con: openssl rand -base64 32)
AUTH_SECRET="cambia-esto-por-un-secreto-largo"
# URL pública de la app (puerto 3025)
APP_URL="http://localhost:3025"
# Notificaciones (opcional). Sin credenciales se registran en consola + NotificationLog
SMTP_URL=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
